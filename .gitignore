# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust build output (workspace root)
/target

# gdrive OAuth client secret (installed-app; loaded at runtime, never committed)
.gdrive_client_secret
src-tauri/.gdrive_client_secret

# kokos-nmh sidecar build artifacts (see src-tauri/binaries/README.md)
src-tauri/binaries/kokos-nmh-*
# ONNX Runtime DLL staged for the Windows bundle (fetched at build time,
# not vendored).
src-tauri/binaries/onnxruntime.dll

# Machine-specific local scripts
.local/

# Linux cross-build in Docker (container cargo cache + target dir)
/.docker-build

# Packaging scratch: staged payload + local flatpak repo (rebuilt on demand)
/packaging/snap/prebuilt
/.flatpak-repo
/packaging/snap/*.snap

# Collected release artifacts + SHA256SUMS (regenerated by packaging/checksums.sh)
/dist-release
